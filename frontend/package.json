{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node scripts/copy-vendor.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"predev": "node scripts/copy-vendor.mjs",
		"prebuild": "node scripts/copy-vendor.mjs",
		"test": "vitest run --passWithNoTests",
		"gen:api": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/dompurify": "^3.2.0",
		"@types/node": "^22",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"jsdom": "26.1.0",
		"mdsvex": "^0.12.8",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^7.3.1",
		"vitest": "3.2.4"
	},
	"dependencies": {
		"@fontsource/inter": "5.3.0",
		"@tiptap/core": "^3.33.0",
		"@tiptap/extension-bold": "^3.33.0",
		"@tiptap/extension-bullet-list": "^3.33.0",
		"@tiptap/extension-code-block-lowlight": "^3.33.0",
		"@tiptap/extension-document": "^3.33.0",
		"@tiptap/extension-hard-break": "^3.33.0",
		"@tiptap/extension-heading": "^3.33.0",
		"@tiptap/extension-history": "^3.33.0",
		"@tiptap/extension-image": "^3.33.0",
		"@tiptap/extension-italic": "^3.33.0",
		"@tiptap/extension-list-item": "^3.33.0",
		"@tiptap/extension-ordered-list": "^3.33.0",
		"@tiptap/extension-paragraph": "^3.33.0",
		"@tiptap/extension-placeholder": "^3.33.0",
		"@tiptap/extension-text": "^3.33.0",
		"@tiptap/pm": "^3.33.0",
		"dompurify": "^3.4.17",
		"lowlight": "^3.3.0",
		"marked": "15.0.12",
		"monaco-editor": "0.57.0",
		"pyodide": "0.27.7",
		"svelte-dnd-action": "^0.9.80",
		"svelte-tiptap": "^3.0.2"
	},
	"packageManager": "pnpm@10.28.0"
}
