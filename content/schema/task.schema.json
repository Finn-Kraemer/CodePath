{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codepath.local/schema/task.schema.json",
  "title": "CodePath-Aufgabe (tasks/*.json)",
  "description": "Texte sind Markdown. Die Konfiguration hängt vom Typ ab; der Server prüft zusätzlich per Probelauf.",
  "type": "object",
  "required": [
    "slug",
    "type",
    "title",
    "difficulty",
    "points",
    "sortOrder",
    "config"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
    },
    "type": {
      "enum": [
        "MULTIPLE_CHOICE",
        "FILL_BLANK",
        "FILL_CODE",
        "CODE",
        "SORTING",
        "SQL",
        "TERMINAL",
        "PRACTICE",
        "MATCHING",
        "PARSONS",
        "NUMBER_CONVERT",
        "HOTSPOT"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "difficulty": {
      "enum": [
        "EASY",
        "MEDIUM",
        "HARD"
      ]
    },
    "points": {
      "type": "integer",
      "minimum": 0
    },
    "sortOrder": {
      "type": "integer"
    },
    "learningGoal": {
      "type": "string"
    },
    "story": {
      "type": "string"
    },
    "assignment": {
      "type": "string"
    },
    "hints": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explanation": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hintPenaltyPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "firstTryBonusPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "revealAllowed": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "type": "object"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "blank": {
      "type": "object",
      "required": [
        "answers"
      ],
      "additionalProperties": false,
      "properties": {
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "expectedOutput"
        ],
        "additionalProperties": false,
        "properties": {
          "stdin": {
            "type": "string"
          },
          "expectedOutput": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "append": {
            "type": "string",
            "description": "Wird an den Code angehängt, z. B. weitere Funktionsaufrufe"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "MULTIPLE_CHOICE"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "options",
              "correct"
            ],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/item"
                    }
                  ],
                  "properties": {
                    "explanation": {
                      "type": "string"
                    }
                  }
                }
              },
              "correct": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "multiple": {
                "type": "boolean"
              },
              "keepOrder": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "FILL_BLANK",
              "FILL_CODE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "template",
              "blanks"
            ],
            "properties": {
              "template": {
                "type": "string",
                "pattern": "___"
              },
              "blanks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/blank"
                }
              },
              "tests": {
                "$ref": "#/$defs/tests"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CODE"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "tests"
            ],
            "properties": {
              "starterCode": {
                "type": "string"
              },
              "solution": {
                "type": "string"
              },
              "tests": {
                "allOf": [
                  {
                    "$ref": "#/$defs/tests"
                  }
                ],
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SORTING"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "items",
              "correctOrder"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/item"
                }
              },
              "correctOrder": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SQL"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "schemaSql",
              "solutionSql"
            ],
            "properties": {
              "schemaSql": {
                "type": "string",
                "minLength": 1
              },
              "solutionSql": {
                "type": "string",
                "pattern": "(?i)^\\s*(select|with)"
              },
              "starterSql": {
                "type": "string"
              },
              "orderMatters": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TERMINAL"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "initialDirectories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "initialFiles": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "expectedDirectories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expectedFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expectedContents": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "allowExtra": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PRACTICE"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "instructions",
              "rubric"
            ],
            "properties": {
              "instructions": {
                "type": "string",
                "minLength": 1
              },
              "submissionNote": {
                "type": "string"
              },
              "rubric": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label",
                    "points"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "points": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
