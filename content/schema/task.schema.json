{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codepath.local/schema/task.schema.json",
  "title": "CodePath-Aufgabe (tasks/*.json)",
  "description": "Texte sind Markdown. Die Konfiguration hängt vom Typ ab; der Server prüft zusätzlich per Probelauf.",
  "type": "object",
  "required": [
    "slug",
    "type",
    "title",
    "difficulty",
    "points",
    "sortOrder",
    "config"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
    },
    "type": {
      "enum": [
        "MULTIPLE_CHOICE",
        "FILL_BLANK",
        "FILL_CODE",
        "CODE",
        "SORTING",
        "SQL",
        "TERMINAL",
        "PRACTICE",
        "MATCHING",
        "PARSONS",
        "NUMBER_CONVERT",
        "HOTSPOT",
        "IMAGE_HOTSPOT",
        "LOGIC_CIRCUIT",
        "DEVTOOLS"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "difficulty": {
      "enum": [
        "EASY",
        "MEDIUM",
        "HARD"
      ]
    },
    "points": {
      "type": "integer",
      "minimum": 0
    },
    "sortOrder": {
      "type": "integer"
    },
    "learningGoal": {
      "type": "string"
    },
    "story": {
      "type": "string"
    },
    "knowledgeArticle": {
      "description": "Adresse eines passenden Artikels der Wissensdatenbank (content/wissen/<adresse>.md)",
      "type": "string",
      "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)?$"
    },
    "assignment": {
      "type": "string"
    },
    "hints": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explanation": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hintPenaltyPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "firstTryBonusPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "revealAllowed": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "type": "object"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "blank": {
      "type": "object",
      "required": [
        "answers"
      ],
      "additionalProperties": false,
      "properties": {
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "expectedOutput"
        ],
        "additionalProperties": false,
        "properties": {
          "stdin": {
            "type": "string"
          },
          "expectedOutput": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "append": {
            "type": "string",
            "description": "Wird an den Code angehängt, z. B. weitere Funktionsaufrufe"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "MULTIPLE_CHOICE"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "options",
              "correct"
            ],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/item"
                    }
                  ],
                  "properties": {
                    "explanation": {
                      "type": "string"
                    }
                  }
                }
              },
              "correct": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "multiple": {
                "type": "boolean"
              },
              "keepOrder": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "FILL_BLANK",
              "FILL_CODE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "template",
              "blanks"
            ],
            "properties": {
              "template": {
                "type": "string",
                "pattern": "___"
              },
              "blanks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/blank"
                }
              },
              "tests": {
                "$ref": "#/$defs/tests"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CODE"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "tests",
              "solution"
            ],
            "properties": {
              "starterCode": {
                "type": "string"
              },
              "solution": {
                "type": "string"
              },
              "tests": {
                "allOf": [
                  {
                    "$ref": "#/$defs/tests"
                  }
                ],
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SORTING"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "items",
              "correctOrder"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/item"
                }
              },
              "correctOrder": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SQL"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "schemaSql",
              "solutionSql"
            ],
            "properties": {
              "schemaSql": {
                "type": "string",
                "minLength": 1
              },
              "solutionSql": {
                "type": "string",
                "pattern": "(?i)^\\s*(select|with)"
              },
              "starterSql": {
                "type": "string"
              },
              "orderMatters": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TERMINAL"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "initialDirectories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "initialFiles": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Pfad → Inhalt; Platzhalter {{name}} auch im Pfad"
              },
              "expectedDirectories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expectedFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expectedContents": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "allowExtra": {
                "type": "boolean"
              },
              "absent": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Pfade, die am Ende nicht mehr existieren dürfen"
              },
              "answer": {
                "description": "Erwartete Antwort im Antwortfeld (oder mehrere); Groß-/Kleinschreibung egal",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "answerLabel": {
                "type": "string",
                "description": "Frage über dem Antwortfeld"
              },
              "solution": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Musterlösung als Befehlsfolge (Pflicht bei answer, gitChecks, absent oder git)"
              },
              "variants": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "description": "Je Person wird eine Variante gewählt; {{name}} wird überall ersetzt, {{code}} ist immer verfügbar"
              },
              "git": {
                "type": "object",
                "additionalProperties": false,
                "description": "Vorbereitetes Git-Repository",
                "properties": {
                  "root": {
                    "type": "string",
                    "description": "Ordner des Repositorys (\"\" = Home)"
                  },
                  "history": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "author": {
                          "type": "string"
                        },
                        "branch": {
                          "type": "string"
                        },
                        "files": {
                          "type": "object",
                          "additionalProperties": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "description": "Pfad relativ zum Repository → Inhalt; null löscht die Datei"
                        }
                      }
                    }
                  },
                  "head": {
                    "type": "string"
                  },
                  "remote": {
                    "description": "true = Server origin mit demselben Stand; Liste = zusätzliche Commits nur auf dem Server",
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "message": {
                              "type": "string"
                            },
                            "author": {
                              "type": "string"
                            },
                            "branch": {
                              "type": "string"
                            },
                            "files": {
                              "type": "object",
                              "additionalProperties": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "description": "Pfad relativ zum Repository → Inhalt; null löscht die Datei"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "gitChecks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "check"
                  ],
                  "properties": {
                    "check": {
                      "enum": [
                        "repo",
                        "commits",
                        "committed",
                        "neverCommitted",
                        "branch",
                        "head",
                        "merged",
                        "clean",
                        "pushed",
                        "tag",
                        "ignored",
                        "author"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "description": "eigene Rückmeldung, wenn die Prüfung fehlschlägt"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PRACTICE"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "instructions",
              "rubric"
            ],
            "properties": {
              "instructions": {
                "type": "string",
                "minLength": 1
              },
              "submissionNote": {
                "type": "string"
              },
              "rubric": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label",
                    "points"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "points": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "codeEditor": {
                "type": "boolean",
                "description": "Python-Werkbank anbieten: Code schreiben, im Browser ausführen, mit abgeben"
              },
              "starterCode": {
                "type": "string"
              },
              "codeRequired": {
                "type": "boolean",
                "description": "Abgabe nur mit Code"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "MATCHING"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "left",
              "right",
              "pairs"
            ],
            "properties": {
              "left": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/item"
                }
              },
              "right": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/item"
                }
              },
              "pairs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "left",
                    "right"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "left": {
                      "type": "string"
                    },
                    "right": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PARSONS"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "lines"
            ],
            "properties": {
              "lines": {
                "type": "array",
                "minItems": 2,
                "description": "In der richtigen Reihenfolge",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "code"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "indent": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    }
                  }
                }
              },
              "distractors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "code"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "checkIndent": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "NUMBER_CONVERT"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "enum": [
                  2,
                  8,
                  10,
                  16
                ]
              },
              "to": {
                "enum": [
                  2,
                  8,
                  10,
                  16
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "values": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string"
                },
                "description": "Feste Werte in der Basis from statt Zufallszahlen"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "HOTSPOT"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "text",
              "targets"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Zeilennummern ab 1"
              },
              "mono": {
                "type": "boolean"
              },
              "showCount": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "IMAGE_HOTSPOT"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "image",
              "alt",
              "targets"
            ],
            "properties": {
              "image": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}\\.(png|jpg|gif|webp)$",
                "description": "Schlüssel eines Bildes in media/"
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "description": "Bildbeschreibung für Screenreader – ohne die Lösung zu verraten"
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "w": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "h": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 100
                    }
                  }
                }
              },
              "showCount": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "LOGIC_CIRCUIT"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "inputs",
              "expression",
              "solution"
            ],
            "properties": {
              "inputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]$"
                }
              },
              "expression": {
                "type": "string",
                "minLength": 1,
                "description": "z. B. (A OR B) AND NOT C"
              },
              "allowedGates": {
                "type": "array",
                "items": {
                  "enum": [
                    "AND",
                    "OR",
                    "NOT",
                    "XOR",
                    "NAND",
                    "NOR",
                    "XNOR"
                  ]
                }
              },
              "maxGates": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "showExpression": {
                "type": "boolean"
              },
              "solution": {
                "type": "object",
                "required": [
                  "gates",
                  "output"
                ],
                "properties": {
                  "gates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "type",
                        "inputs"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9]{0,9}$"
                        },
                        "type": {
                          "enum": [
                            "AND",
                            "OR",
                            "NOT",
                            "XOR",
                            "NAND",
                            "NOR",
                            "XNOR"
                          ]
                        },
                        "inputs": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 2,
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "output": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "DEVTOOLS"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "scenario"
            ],
            "additionalProperties": false,
            "properties": {
              "scenario": {
                "enum": [
                  "wetter",
                  "shop",
                  "escape"
                ],
                "description": "Vorlage der Übungsseite (Browser-Labor)"
              }
            }
          }
        }
      }
    }
  ]
}
