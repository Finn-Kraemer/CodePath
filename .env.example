# Kopieren nach .env und Werte setzen. Zufallswerte z. B. mit: openssl rand -base64 32
POSTGRES_PASSWORD=
# Optional: Passwort des Admin-Kontos beim ersten Start. Leer = wird erzeugt und ins Log geschrieben.
ADMIN_SEED_PASSWORD=
# Optional: Port auf dem Host (Standard 8080)
CODEPATH_PORT=8080
# Hinter TLS auf true setzen, damit das Session-Cookie nur über HTTPS geht
COOKIE_SECURE=false
