# Kopieren nach .env und Werte setzen. Zufallswerte z. B. mit: openssl rand -base64 32
POSTGRES_PASSWORD=
# Optional: Passwort des Admin-Kontos beim ersten Start. Leer = wird erzeugt und ins Log geschrieben.
ADMIN_SEED_PASSWORD=
# Optional: Port auf dem Host (Standard 8080)
CODEPATH_PORT=8080
# Hinter TLS auf true setzen, damit das Session-Cookie nur über HTTPS geht
COOKIE_SECURE=false

# Optional: Code-Runner für serverseitig bewertete Python-Aufgaben (docs/phase-4.md).
# Zum Einschalten alle drei Zeilen setzen; RUNNER_TOKEN mit openssl rand -hex 32 erzeugen.
# COMPOSE_PROFILES=runner
# CODEPATH_RUNNER_URL=http://runner:8000
# RUNNER_TOKEN=
